{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dikwp.example/schemas/clearpath-person-v1.json",
  "title": "ClearPath Person Profile",
  "type": "object",
  "required": ["profile_id", "purpose", "weekly_hours", "runway_months", "experiment_budget", "storage", "transformations"],
  "properties": {
    "profile_id": {"type": "string", "minLength": 1},
    "purpose": {"type": "string", "minLength": 1},
    "weekly_hours": {"type": "number", "minimum": 0},
    "runway_months": {"type": "number", "minimum": 0},
    "experiment_budget": {"type": "number", "minimum": 0},
    "risk_tolerance": {"type": "number", "minimum": 0, "maximum": 1},
    "customer_access": {"type": "number", "minimum": 0, "maximum": 1},
    "trust_access": {"type": "number", "minimum": 0, "maximum": 1},
    "distribution_access": {"type": "number", "minimum": 0, "maximum": 1},
    "local_execution": {"type": "number", "minimum": 0, "maximum": 1},
    "regulated_access": {"type": "number", "minimum": 0, "maximum": 1},
    "currency": {"type": "string"},
    "storage": {
      "type": "object",
      "required": ["D", "I", "K", "W", "P"],
      "properties": {
        "D": {"type": "number", "minimum": 0, "maximum": 1},
        "I": {"type": "number", "minimum": 0, "maximum": 1},
        "K": {"type": "number", "minimum": 0, "maximum": 1},
        "W": {"type": "number", "minimum": 0, "maximum": 1},
        "P": {"type": "number", "minimum": 0, "maximum": 1}
      },
      "additionalProperties": false
    },
    "transformations": {"type": "object"},
    "private_constraints": {"type": "object"}
  },
  "additionalProperties": true
}

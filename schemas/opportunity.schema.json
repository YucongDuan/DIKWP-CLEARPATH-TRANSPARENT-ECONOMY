{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dikwp.example/schemas/clearpath-opportunity-v1.json",
  "title": "ClearPath Opportunity Truth Record",
  "type": "object",
  "required": [
    "opportunity_id", "title", "customer_segment", "funded_slots_12m",
    "qualified_supply_now", "new_supply_12m", "automation_rate",
    "price_per_outcome", "variable_cost_per_outcome", "entry_cost",
    "time_to_first_revenue_months", "remaining_lifetime_months",
    "required_transformations"
  ],
  "properties": {
    "opportunity_id": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "customer_segment": {"type": "string", "minLength": 1},
    "funded_slots_12m": {"type": "number", "minimum": 0},
    "qualified_supply_now": {"type": "number", "minimum": 0},
    "new_supply_12m": {"type": "number", "minimum": 0},
    "demand_growth_rate": {"type": "number"},
    "supply_growth_rate": {"type": "number"},
    "automation_rate": {"type": "number", "minimum": 0, "maximum": 1},
    "price_per_outcome": {"type": "number", "minimum": 0},
    "variable_cost_per_outcome": {"type": "number", "minimum": 0},
    "entry_cost": {"type": "number", "minimum": 0},
    "time_to_first_revenue_months": {"type": "number", "exclusiveMinimum": 0},
    "required_weekly_hours": {"type": "number", "minimum": 0},
    "remaining_lifetime_months": {"type": "number", "exclusiveMinimum": 0},
    "customer_access_requirement": {"type": "number", "minimum": 0, "maximum": 1},
    "trust_requirement": {"type": "number", "minimum": 0, "maximum": 1},
    "distribution_requirement": {"type": "number", "minimum": 0, "maximum": 1},
    "regulatory_requirement": {"type": "number", "minimum": 0, "maximum": 1},
    "local_execution_requirement": {"type": "number", "minimum": 0, "maximum": 1},
    "accountability_share": {"type": "number", "minimum": 0, "maximum": 1},
    "physical_world_share": {"type": "number", "minimum": 0, "maximum": 1},
    "local_context_share": {"type": "number", "minimum": 0, "maximum": 1},
    "top10_supplier_share": {"type": "number", "minimum": 0, "maximum": 1},
    "training_seats_marketed": {"type": "number", "minimum": 0},
    "training_price": {"type": "number", "minimum": 0},
    "marketing_certainty": {"type": "number", "minimum": 0, "maximum": 1},
    "required_transformations": {"type": "object"},
    "evidence_notes": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
